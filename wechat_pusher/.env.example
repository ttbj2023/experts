# WeChat Pusher 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ==================== DeepSeek AI 配置 ====================
# DeepSeek API 密钥（从 https://platform.deepseek.com/api_keys 获取）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# DeepSeek API 基础 URL
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 模型选择
# - deepseek-v4-pro: 旗舰版，高性能推理，支持思考模式（推荐）
#   - 用于：内容优化、图表需求分析（复杂任务）
# - deepseek-v4-flash: 轻量版，极低成本，支持思考模式
#   - 自动用于：摘要生成、配图提示词生成（简单任务）
#   - 如配置为 flash，所有任务都将使用 flash 模型
# 注意：deepseek-chat 和 deepseek-reasoner 已弃用，请使用 V4 模型
DEEPSEEK_MODEL=deepseek-v4-pro
# 最大生成 token 数（V4 模型最大输出 384K）
DEEPSEEK_MAX_TOKENS=4000
# 温度参数（0.0-2.0，越高越随机）
DEEPSEEK_TEMPERATURE=0.7

# ==================== 豆包 AI 配置 ====================
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_MODEL=doubao-seedream-4-5-251128
DOUBAO_IMAGE_SIZE=1024x1024

# ==================== 微信公众号配置 ====================
# 公众号AppID（可在微信公众平台-开发-基本配置中获取）
WECHAT_APPID=wx1234567890abcdef

# 公众号AppSecret（可在微信公众平台-开发-基本配置中获取）
WECHAT_SECRET=your-wechat-app-secret

# AccessToken缓存时间（秒，默认7200秒）
WECHAT_TOKEN_EXPIRE=7200

# ==================== 应用配置 ====================
# 输出目录
OUTPUT_DIR=./output

# 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=./logs/wechat_pusher.log

# 是否启用彩色日志输出
LOG_COLOR=true

# ==================== 模板配置 ====================
# 默认HTML模板（basic, card, custom）
DEFAULT_TEMPLATE=basic

# 是否在代码块中启用语法高亮
ENABLE_SYNTAX_HIGHLIGHT=true

# ==================== API调用配置 ====================
# API请求超时时间（秒）
API_TIMEOUT=30

# API重试次数
API_RETRY_TIMES=3

# API重试间隔（秒）
API_RETRY_INTERVAL=1

# 是否启用异步API调用（提升性能）
ENABLE_ASYNC_API=false

# ==================== 图片配置 ====================
# 封面图宽度（像素）
COVER_IMAGE_WIDTH=900

# 封面图高度（像素）
COVER_IMAGE_HEIGHT=506

# 插图最大宽度（像素）
IMAGE_MAX_WIDTH=1080

# 图片格式（jpg, png）
IMAGE_FORMAT=png

# 图片质量（1-100，适用于jpg格式）
IMAGE_QUALITY=95

# ==================== 内容生成配置 ====================
# 摘要长度（字数）
SUMMARY_LENGTH=200

# 是否自动生成配图
AUTO_GENERATE_IMAGES=true

# 每篇文章最大插图数量
MAX_IMAGES_PER_ARTICLE=10

# ==================== 微信文章配置 ====================
# 文章作者（默认）
DEFAULT_AUTHOR=

# 文章是否显示原创标识
SHOW_ORIGINAL=false

# 是否开启评论
ENABLE_COMMENTS=true

# 是否仅粉丝可见
FANS_ONLY=false
