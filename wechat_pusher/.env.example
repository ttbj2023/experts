# WeChat Pusher 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ==================== DeepSeek AI 配置 ====================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4000
DEEPSEEK_TEMPERATURE=0.7

# ==================== 豆包 AI 配置 ====================
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_MODEL=doubao-v3
DOUBAO_IMAGE_SIZE=1024x1024

# ==================== 微信公众号配置 ====================
# 公众号AppID（可在微信公众平台-开发-基本配置中获取）
WECHAT_APPID=wx1234567890abcdef

# 公众号AppSecret（可在微信公众平台-开发-基本配置中获取）
WECHAT_SECRET=your-wechat-app-secret

# AccessToken缓存时间（秒，默认7200秒）
WECHAT_TOKEN_EXPIRE=7200

# ==================== 应用配置 ====================
# 输出目录
OUTPUT_DIR=./output

# 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=./logs/wechat_pusher.log

# 是否启用彩色日志输出
LOG_COLOR=true

# ==================== 图表配置 ====================
# 图表默认样式主题（default, minimal, classic, seaborn）
CHART_STYLE=default

# 图表DPI（分辨率）
CHART_DPI=150

# 图表默认宽度（英寸）
CHART_FIGURE_WIDTH=10

# 图表默认高度（英寸）
CHART_FIGURE_HEIGHT=6

# ==================== 模板配置 ====================
# 默认HTML模板（basic, card, custom）
DEFAULT_TEMPLATE=basic

# 是否在代码块中启用语法高亮
ENABLE_SYNTAX_HIGHLIGHT=true

# ==================== API调用配置 ====================
# API请求超时时间（秒）
API_TIMEOUT=30

# API重试次数
API_RETRY_TIMES=3

# API重试间隔（秒）
API_RETRY_INTERVAL=1

# 是否启用异步API调用（提升性能）
ENABLE_ASYNC_API=false

# ==================== 图片配置 ====================
# 封面图宽度（像素）
COVER_IMAGE_WIDTH=900

# 封面图高度（像素）
COVER_IMAGE_HEIGHT=506

# 插图最大宽度（像素）
IMAGE_MAX_WIDTH=1080

# 图片格式（jpg, png）
IMAGE_FORMAT=png

# 图片质量（1-100，适用于jpg格式）
IMAGE_QUALITY=95

# ==================== 内容生成配置 ====================
# 摘要长度（字数）
SUMMARY_LENGTH=200

# 是否自动生成配图
AUTO_GENERATE_IMAGES=true

# 是否自动生成图表
AUTO_GENERATE_CHARTS=true

# 每篇文章最大插图数量
MAX_IMAGES_PER_ARTICLE=10

# ==================== 微信文章配置 ====================
# 文章作者（默认）
DEFAULT_AUTHOR=

# 文章是否显示原创标识
SHOW_ORIGINAL=false

# 是否开启评论
ENABLE_COMMENTS=true

# 是否仅粉丝可见
FANS_ONLY=false
